<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MiSTerKVMS.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:MiSTerKVMS.Core"
    Title="MiSTerKVMS">

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Hosts -->
        <Grid Grid.Column="0" Padding="8,8,4,8" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Padding="8,0,0,0">
                <TextBlock Text="Hosts" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Click="AddHost_Click" ToolTipService.ToolTip="Add a host"
                        Style="{StaticResource SubtleButtonStyle}">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                </Button>
            </Grid>
            <ListView x:Name="HostList" Grid.Row="1" SelectionMode="Single"
                      SelectionChanged="HostList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:HostProfile">
                        <StackPanel Padding="0,6" Spacing="2">
                            <StackPanel.ContextFlyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Text="Edit…" Icon="Edit" Click="EditHostMenu_Click" Tag="{x:Bind Id}" />
                                    <MenuFlyoutItem Text="Delete" Icon="Delete" Click="DeleteHostMenu_Click" Tag="{x:Bind Id}" />
                                </MenuFlyout>
                            </StackPanel.ContextFlyout>
                            <TextBlock Text="{x:Bind Name}" />
                            <TextBlock Text="{x:Bind MisterHost}" Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="NoHosts" Grid.Row="1" VerticalAlignment="Center" Spacing="8" Padding="16"
                        Visibility="Collapsed">
                <FontIcon Glyph="&#xE7F4;" FontSize="36" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="No hosts" HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock Text="Add a MiSTer and the NDI source that carries its video." TextWrapping="Wrap"
                           TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Add host…" HorizontalAlignment="Center" Click="AddHost_Click" />
            </StackPanel>
        </Grid>

        <!-- Session -->
        <Grid Grid.Column="1" Margin="4,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <CommandBar x:Name="Toolbar" DefaultLabelPosition="Right" HorizontalAlignment="Left"
                        IsEnabled="False" Background="Transparent">
                <AppBarButton x:Name="MenuButton" Label="MiSTer Menu" Click="Menu_Click"
                              ToolTipService.ToolTip="Sends F12, which opens the MiSTer menu (OSD). You can also press F12 while capturing.">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE700;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Name="CaptureButton" Label="Capture" Click="Capture_Click"
                              ToolTipService.ToolTip="Send keyboard and mouse to MiSTer (or click the screen)">
                    <AppBarButton.Icon><FontIcon x:Name="CaptureIcon" Glyph="&#xE962;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarToggleButton x:Name="FitButton" Label="Fit" Click="Scale_Click" Tag="Fit"
                                    ToolTipService.ToolTip="Fill the window, keeping the shape">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE9A6;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="IntegerButton" Label="Integer" Click="Scale_Click" Tag="Integer"
                                    ToolTipService.ToolTip="Sharpest whole-number scale">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE80A;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarToggleButton x:Name="NativeButton" Label="1:1" Click="Scale_Click" Tag="Native"
                                    ToolTipService.ToolTip="One MiSTer pixel per screen pixel (at 100% scaling)">
                    <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8B3;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarSeparator />
                <AppBarButton Icon="ZoomOut" Label="Zoom out" LabelPosition="Collapsed" Click="ZoomOut_Click"
                              ToolTipService.ToolTip="Zoom out (Ctrl+−)" />
                <AppBarButton x:Name="ZoomButton" Label="100%" Click="ResetZoom_Click"
                              ToolTipService.ToolTip="Reset zoom (Ctrl+0)" />
                <AppBarButton Icon="ZoomIn" Label="Zoom in" LabelPosition="Collapsed" Click="ZoomIn_Click"
                              ToolTipService.ToolTip="Zoom in (Ctrl+=)" />
                <AppBarSeparator />
                <AppBarButton x:Name="RecordButton" Label="Record" Click="Record_Click"
                              ToolTipService.ToolTip="Record video and audio to Videos\MiSTerKVMS (Ctrl+Shift+R)">
                    <AppBarButton.Icon><FontIcon x:Name="RecordIcon" Glyph="&#xE7C8;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarToggleButton x:Name="MuteButton" Label="Mute" LabelPosition="Collapsed" Click="Mute_Click"
                                    ToolTipService.ToolTip="Mute (Ctrl+Shift+M)">
                    <AppBarToggleButton.Icon><FontIcon x:Name="MuteIcon" Glyph="&#xE767;" /></AppBarToggleButton.Icon>
                </AppBarToggleButton>

                <CommandBar.SecondaryCommands>
                    <AppBarToggleButton x:Name="SmoothButton" Label="Smooth scaling" Click="Smooth_Click">
                        <AppBarToggleButton.Icon><FontIcon Glyph="&#xE771;" /></AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarToggleButton x:Name="AutoCropButton" Label="Auto-crop borders" Click="AutoCrop_Click">
                        <AppBarToggleButton.Icon><FontIcon Glyph="&#xE7A8;" /></AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarToggleButton x:Name="PredictiveButton" Label="Predictive cursor" Click="Predictive_Click">
                        <AppBarToggleButton.Icon><FontIcon Glyph="&#xE8B0;" /></AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarSeparator />
                    <AppBarButton Label="Send Ctrl+Alt+Del" Click="CtrlAltDel_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE72E;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Edit host…" Icon="Edit" Click="EditHost_Click" />
                    <AppBarSeparator />
                    <AppBarButton Label="Show stats" Click="ShowStats_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE9D9;" /></AppBarButton.Icon>
                        <AppBarButton.KeyboardAccelerators>
                            <KeyboardAccelerator Modifiers="Control" Key="I" />
                        </AppBarButton.KeyboardAccelerators>
                    </AppBarButton>
                    <AppBarToggleButton x:Name="PinStatsButton" Label="Pin stats overlay" Click="PinStats_Click">
                        <AppBarToggleButton.Icon><FontIcon Glyph="&#xE718;" /></AppBarToggleButton.Icon>
                    </AppBarToggleButton>
                    <AppBarButton x:Name="ShowRecordingButton" Label="Show last recording" Click="ShowRecording_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8B7;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <CommandBar Grid.Row="0" HorizontalAlignment="Right" DefaultLabelPosition="Collapsed" Background="Transparent">
                <CommandBar.SecondaryCommands>
                    <AppBarButton Label="Export hosts…" Click="Export_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Import hosts…" Click="Import_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE8B5;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Label="Open log" Click="OpenLog_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE9F9;" /></AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarSeparator />
                    <AppBarButton Label="About MiSTerKVMS" Click="About_Click">
                        <AppBarButton.Icon><FontIcon Glyph="&#xE946;" /></AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <!-- Video: the core draws into VideoHost's composition visual;
                 everything after it in this grid draws on top. -->
            <Grid x:Name="VideoArea" Grid.Row="1" Background="Black" CornerRadius="8,0,0,0"
                  PointerPressed="Video_PointerPressed" PointerWheelChanged="Video_PointerWheelChanged">
                <Grid x:Name="VideoHost" />

                <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8"
                            IsHitTestVisible="False" MaxWidth="460">
                    <FontIcon x:Name="PlaceholderIcon" Glyph="&#xE7F4;" FontSize="48" Foreground="#99FFFFFF" />
                    <TextBlock x:Name="PlaceholderTitle" Foreground="White" HorizontalAlignment="Center"
                               Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock x:Name="PlaceholderDetail" Foreground="#B3FFFFFF" HorizontalAlignment="Center"
                               Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" TextAlignment="Center" />
                    <TextBlock x:Name="PlaceholderHint" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,0"
                               Text="Click here to capture keyboard and mouse" />
                </StackPanel>

                <Border x:Name="CaptureHint" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="12"
                        Padding="16,10" CornerRadius="10" Background="#BF000000" IsHitTestVisible="False"
                        Visibility="Collapsed">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Keyboard and mouse go to MiSTer" Foreground="White" HorizontalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <TextBlock Foreground="White" HorizontalAlignment="Center">
                            Press <Bold>Right Win + Right Alt + Esc</Bold> to release · <Bold>F12</Bold> opens the MiSTer menu
                        </TextBlock>
                        <TextBlock Foreground="#FFFFD54F" HorizontalAlignment="Center" FontSize="12"
                                   Text="Windows keeps Ctrl+Alt+Del and Win+L: use the toolbar to send Ctrl+Alt+Del." />
                    </StackPanel>
                </Border>

                <Border x:Name="StatsPanel" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12"
                        Padding="8" CornerRadius="6" Background="#99000000" MinWidth="250" Visibility="Collapsed">
                    <Grid>
                        <TextBlock x:Name="StatsText" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="#FF4CE06A" IsTextSelectionEnabled="False" />
                        <Button x:Name="StatsPin" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="4"
                                Click="StatsPin_Click" Style="{StaticResource SubtleButtonStyle}"
                                ToolTipService.ToolTip="Pin: always show (Ctrl+Shift+I)">
                            <FontIcon x:Name="StatsPinIcon" Glyph="&#xE718;" FontSize="12" Foreground="#FF4CE06A" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <!-- Status bar -->
            <Grid Grid.Row="2" Padding="12,6" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="Red" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Style="{StaticResource CaptionTextBlockStyle}" Text="Not connected"
                               VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse x:Name="RecordingDot" Width="8" Height="8" Fill="Red" Visibility="Collapsed" />
                    <TextBlock x:Name="RecordingText" Style="{StaticResource CaptionTextBlockStyle}" />
                    <HyperlinkButton x:Name="LastRecordingLink" Padding="0" FontSize="12" Click="ShowRecording_Click"
                                     Visibility="Collapsed" />
                </StackPanel>
                <TextBlock Grid.Column="3" x:Name="GameText" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="4" x:Name="CaptureText" Style="{StaticResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center" Text="Not capturing"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
