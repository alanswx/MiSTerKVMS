<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Merged with the keys Xcode generates (INFOPLIST_KEY_* in the project). -->
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_mkvm._tcp</string>
	</array>
	<!-- The app encrypts its own connections from the internet with standard
	     algorithms (Noise: X25519, ChaCha20-Poly1305, BLAKE2s; IPHONE.md §3),
	     declared exempt (mass market). Changing that means filing export
	     compliance documentation in App Store Connect and adding its
	     ITSEncryptionExportComplianceCode here. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
