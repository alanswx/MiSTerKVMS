<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Merged with the keys Xcode generates (INFOPLIST_KEY_* in the project). -->
<dict>
	<key>NSBonjourServices</key>
	<array>
		<string>_mkvm._tcp</string>
	</array>
	<!-- The app encrypts its connections from the internet itself (Noise:
	     X25519, ChaCha20-Poly1305, BLAKE2s; IPHONE.md §3), not only through
	     iOS. App Store Connect asks the export compliance questions for it. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<true/>
</dict>
</plist>
